# Railway pergjithmone (frontend) service:
#   Root Directory = /
#   Config-as-code  = /artifacts/pergjithmone/railway.toml
FROM node:22-bookworm-slim
WORKDIR /app

ENV CI=true \
    NODE_ENV=production \
    PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    BASE_PATH=/ \
    PORT=8080

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY tsconfig.base.json tsconfig.json ./
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts
COPY attached_assets ./attached_assets

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/pergjithmone build

WORKDIR /app/artifacts/pergjithmone
EXPOSE 8080
# Serves the static build; /api is proxied via vite preview → API_URL
CMD ["pnpm", "exec", "vite", "preview", "--config", "vite.config.ts", "--host", "0.0.0.0", "--port", "8080"]
